# ---------------------------------------------------------------------------
# Database connection
# ---------------------------------------------------------------------------
# Pooled connection string, used by the Bun server and scripts.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection. Use this for migrations / bulk loads.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Neon branch tooling
# ---------------------------------------------------------------------------
# Project that owns the branches (required for branch:* commands).
NEON_PROJECT_ID=
# Database name inside each branch.
NEON_DATABASE_NAME=neondb
# Branch used as the parent when creating new branches.
NEON_PARENT_BRANCH=main
# Branch that DATABASE_URL points at (written by `neon env pull`).
# Used by reports to avoid an extra CLI round trip.
NEON_BRANCH=main
# Optional: only needed in CI or when the CLI is not signed in.
# NEON_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
DB_POOL_SIZE=5
