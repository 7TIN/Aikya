# ---------------------------------------------------------------------------
# Database connection
# ---------------------------------------------------------------------------
# Pooled connection string, used by the Bun server and scripts.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection. Use this for migrations / bulk loads.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Neon branch tooling
# ---------------------------------------------------------------------------
# Project that owns the branches (required for branch:* commands).
NEON_PROJECT_ID=
# Database name inside each branch.
NEON_DATABASE_NAME=neondb
# Branch used as the parent when creating new branches.
NEON_PARENT_BRANCH=main
# Branch that DATABASE_URL points at (written by `neon env pull`).
# Used by reports to avoid an extra CLI round trip.
NEON_BRANCH=main
# Optional: only needed in CI or when the CLI is not signed in.
# NEON_API_KEY=
# Subject project keys for watched repos. The variable names must match
# `apiKeyEnv` in config/repos.json; missing keys fail closed.
# NEON_API_KEY_7TIN_GH_LAB=
# Override the preview registry (advanced / tests):
# AIKYA_REPO_REGISTRY=config/repos.json
# AIKYA_LOCAL_REPO_REGISTRY=config/repos.local.json
# Vercel Sandbox backend (optional, `vercel link` + `vercel env pull` required):
# VERCEL_OIDC_TOKEN=
# For token auth instead of OIDC (all three are required together):
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=

# ---------------------------------------------------------------------------
# GitHub repository watcher (local PR monitoring)
# ---------------------------------------------------------------------------
# Public repo to monitor, in owner/name form. Empty disables the watcher.
GITHUB_REPO=7TIN/gh-lab
# Comma-separated alternative for several repos:
# GITHUB_REPOS=owner/one,owner/two
# Optional read-only token: raises the API rate limit and allows private repos.
# GITHUB_TOKEN=
# Poll interval in milliseconds. 120000 stays well under the unauthenticated
# 60 requests/hour limit; lower it when GITHUB_TOKEN is set.
GITHUB_POLL_MS=120000
# Run this project's tests for each preview branch (default true).
GITHUB_WATCH_TESTS=true
# Sync immediately when the server starts (default true).
GITHUB_WATCH_ON_START=true
# Retry a failed preview after this backoff (default 300000 = 5 minutes).
# GITHUB_WATCH_RETRY_MS=300000
# Parent branch for watched previews (NEON_PARENT_BRANCH wins when both are set).
# GITHUB_WATCH_PARENT=main
# Override the watcher state file (default artifacts/monitor/state.json).
# GITHUB_WATCH_STATE=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
DB_POOL_SIZE=5
